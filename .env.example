# --- MV Design · variables d'environnement (aucun secret ici) ---

# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.mvdesign.example

# Formulaire de contact — service e-mail (Resend). Laisser vide pour activer le fallback mailto: annoncé à l'utilisateur.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Limitation de requêtes du formulaire (par IP, fenêtre glissante)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Analytics — chargées uniquement après consentement. Laisser vide pour désactiver.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
